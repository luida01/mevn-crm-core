# Copy this file to .env for local development. Do not commit .env.
JWT_SECRET=replace_with_at_least_32_random_characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_password_of_at_least_12_characters
# Optional Stripe test-mode Checkout. Get test keys in a Stripe account dashboard.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd
SHOP_URL=http://localhost:5173

# Docker captures mail in Mailpit: http://localhost:8025 (no external delivery).
# In production use your provider's SMTP settings, a verified sender and TLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=MangaGo <avisos@mangago.test>
# Set a long random value in production for the protected stock-alert scheduler.
CRON_SECRET=
